<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Praktikum</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Към съдържанието</a>
    <header class="site-header">
        <div class="container header-inner">
            <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark" aria-hidden="true">P</span>Praktikum</a>
            <nav id="site-nav" class="site-nav" aria-label="Основна навигация">
                <span class="nav-spacer"></span>
                <a class="nav-link" asp-controller="Home" asp-action="Privacy">Поверителност</a>
            </nav>
        </div>
    </header>

    <main id="main" class="container main-content">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-inner">
            <span>&copy; 2026 Praktikum - дипломен проект, ЧПГДН „СофтУни Будител“</span>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

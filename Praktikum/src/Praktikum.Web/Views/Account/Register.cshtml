@model Praktikum.Web.ViewModels.Account.RegisterViewModel
@{
    ViewData["Title"] = "Регистрация";
}

<section class="card auth-card">
    <h1>Регистрация на ученик</h1>
    <p>Профили на работодатели, наставници и координатори се създават от администратор.</p>

    <form asp-action="Register" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="FirstName"></label>
                <input asp-for="FirstName" autocomplete="given-name" autofocus />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LastName"></label>
                <input asp-for="LastName" autocomplete="family-name" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="ClassName"></label>
            <input asp-for="ClassName" placeholder="например 12А" />
            <span asp-validation-for="ClassName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Email"></label>
            <input asp-for="Email" autocomplete="username" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password"></label>
            <input asp-for="Password" autocomplete="new-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-block">Регистрирай се</button>
    </form>

    <p class="card-footer">Вече имате профил? <a asp-action="Login">Влезте</a></p>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
